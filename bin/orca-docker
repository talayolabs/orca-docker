#!/usr/bin/env bash
# orca-docker — run a coding agent inside its own isolated Linux desktop container.
#
# Designed to be Orca's per-agent command override (Settings → Agents → Claude → command):
#     orca-docker claude
# Orca appends its own arguments (--model, --prefill, --resume <id>, ...); everything after
# the agent name is forwarded verbatim. One Orca agent tab == one container, kept between
# launches: relaunching the tab (e.g. --resume) restarts the same container.
#
# Nothing from the host is mounted. On first launch the container receives a clone of the
# repository at the same absolute path (checked out on a new branch, default orca/<tab>),
# plus copies of the agent login/config and Orca's hook script. Work leaves the container
# only when the agent (or you) runs `orca-docker publish` inside it — or automatically when
# the agent exits with unpublished commits: the branch is fetched into the host repository,
# pushed to origin when there is one, and the resulting branch/PR URL is printed in the pane.
#
# Standalone use:
#     cd ~/my-project && orca-docker claude
#     orca-docker shell [tab|name]            # terminal inside this worktree's session container
#                                             (from any Orca terminal tab; picks when there are several)
#     orca-docker desktop [tab|name]          # open that container's desktop (noVNC) in Orca's browser pane
#     orca-docker --shell                     # interactive bash as *this* tab's agent (creates the session)
#     orca-docker --sessions                  # list session containers
#     orca-docker --rm-session <tab|name>     # remove a session container (the only way it is deleted)
#     orca-docker --gc [--all]                # remove stopped sessions older than ORCA_DOCKER_GC_DAYS (14)
#     orca-docker --build                     # build the default image from this checkout
#     orca-docker --fresh claude              # discard this tab's container and start over
#
# Per-workspace environment (Orca "Run on" recipe, see orca.yaml at the repo root): one container per
# Orca worktree, with sshd, so Orca's file tree, editor, git, search, terminals and agents all
# run *inside* the container. Orca calls these from the recipe; they speak Orca's recipe protocol
# (ORCA_VM_* / ORCA_REPO_* environment in, one JSON result on stdout, lifecycle payload on stdin):
#     orca-docker env create                  # create + start the container, clone the repo, print the SSH result
#     orca-docker env suspend|resume|destroy  # stop / start / remove it (Orca passes the instance on stdin)
#     orca-docker env ls                      # list environment containers
#     orca-docker env destroy <container>     # remove one by hand
# Inside such a container `orca-docker claude` is the agent launcher and admits one agent per
# workspace (a second agent tab exits with a message: create another workspace instead).
#
# Configuration (environment variables, all optional):
#   ORCA_DOCKER_IMAGE           explicit image to use (highest priority)
#   ORCA_DOCKER_DOCKERFILE      Dockerfile to build the per-repo image from
#                               (default: <worktree>/docker/Dockerfile, then <worktree>/.orca-docker/Dockerfile)
#   ORCA_DOCKER_DEFAULT_IMAGE   fallback image (default: ghcr.io/talayolabs/orca-docker:latest)
#   ORCA_DOCKER_NETWORK         host (default on Linux) | bridge   (environments default to bridge)
#   ORCA_DOCKER_STATE_DIR       host dir for environment SSH keys (default ~/.local/state/orca-docker)
#   ORCA_DOCKER_BRANCH          in-container working branch (default: orca/<tab>)
#   ORCA_DOCKER_PUBLISH         local | push (default when origin exists) | pr | off
#                               local: fetch into the host repo; push: + push to origin; pr: + open a PR with gh
#   ORCA_DOCKER_CARRY_CHANGES=0 do not carry the host's uncommitted changes into the clone
#   ORCA_DOCKER_AUTOCOMMIT=1    on exit, commit uncommitted changes in the container before auto-publishing
#   ORCA_DOCKER_SEED            extra host paths to copy into the container on creation (space separated)
#   ORCA_DOCKER_ARGS            extra raw `docker create` arguments (word split)
#   ORCA_DOCKER_KEEP_RUNNING=1  leave the container running after the agent exits (default: stop it)
#   ORCA_DOCKER_DESKTOP=0 / ORCA_DOCKER_AUTO_INSTALL=0 / ORCA_DOCKER_MCP=0 / ORCA_DOCKER_DISPLAY_SIZE / ORCA_DOCKER_INIT
#                               forwarded to the container (see image/supervisor.sh, image/run-agent.sh)
set -euo pipefail

VERSION="0.2.0"
DEFAULT_IMAGE="${ORCA_DOCKER_DEFAULT_IMAGE:-ghcr.io/talayolabs/orca-docker:latest}"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_IMAGE_DIR="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/image"
LABEL=orca-docker=1

log()  { printf '[orca-docker] %s\n' "$*" >&2; }
die()  { log "error: $*"; exit 1; }

usage() {
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'
}

slugify() { printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '-' | sed -e 's/^-*//' -e 's/-*$//' | cut -c1-48; }
container_name() { echo "orca-docker-$(slugify "$1")"; }

# session_container [tab|name]: sets SESSION_CONTAINER to a started session container of this
# worktree (an Orca terminal tab has its own ORCA_TAB_ID, so the agent's container is found by the
# worktree label, not the tab). One running container wins; otherwise the user picks.
session_container() {
  local want="${1:-}" cand rows n i pick
  SESSION_CONTAINER=""; SESSION_STARTED_HERE=0
  if [ -n "$want" ]; then
    for cand in "$want" "$(container_name "$want")"; do
      docker container inspect "$cand" >/dev/null 2>&1 && { SESSION_CONTAINER="$cand"; break; }
    done
    [ -n "$SESSION_CONTAINER" ] || die "no session container for '$want' (orca-docker --sessions)"
  else
    rows="$(docker ps -a --filter "label=$LABEL" --filter "label=orca-docker.worktree=$(pwd -P)" \
      --format '{{.Names}}\t{{.State}}\t{{.Label "orca-docker.kind"}}\t{{.Label "orca-docker.branch"}}\t{{.Status}}' |
      sort -t "$(printf '\t')" -k2,2r)"  # running first
    [ -n "$rows" ] || die "no session container for this worktree ($(pwd -P)); start an agent tab first, or pass a tab id / name (orca-docker --sessions)"
    n="$(printf '%s\n' "$rows" | wc -l)"
    if [ "$n" = 1 ] || [ "$(printf '%s\n' "$rows" | awk -F'\t' '$2=="running"' | wc -l)" = 1 ]; then
      SESSION_CONTAINER="$(printf '%s\n' "$rows" | awk -F'\t' 'NR==1{print $1}')"
    else
      [ -t 0 ] || die "several session containers for this worktree; pass one:$(printf '\n  %s' "$(printf '%s\n' "$rows" | cut -f1,2,4 | tr '\t' ' ')")"
      log "several session containers for this worktree:"
      i=0
      while IFS=$'\t' read -r name state kind branch status; do
        i=$((i + 1))
        printf '  %d) %-52s %-8s %-6s %s  (%s)\n' "$i" "$name" "$state" "${kind:-tab}" "$branch" "$status" >&2
      done <<< "$rows"
      read -r -p "[orca-docker] which one? [1-$n] " pick </dev/tty
      [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le "$n" ] || die "no such choice"
      SESSION_CONTAINER="$(printf '%s\n' "$rows" | awk -F'\t' -v n="$pick" 'NR==n{print $1}')"
    fi
  fi
  if [ "$(docker container inspect -f '{{.State.Status}}' "$SESSION_CONTAINER")" != running ]; then
    log "starting $SESSION_CONTAINER"
    docker start "$SESSION_CONTAINER" >/dev/null || die "could not start $SESSION_CONTAINER"
    SESSION_STARTED_HERE=1
  fi
  for _ in $(seq 1 300); do  # the desktop session must be up before a login shell sources its env
    docker exec "$SESSION_CONTAINER" sh -c '[ -f /run/orca-docker/ready ] && [ /run/orca-docker/ready -nt /proc/1 ]' 2>/dev/null && break
    [ "$(docker container inspect -f '{{.State.Status}}' "$SESSION_CONTAINER")" = running ] || die "$SESSION_CONTAINER stopped: $(docker logs --tail 5 "$SESSION_CONTAINER" 2>&1)"
    sleep 0.1
  done
}

# open_in_orca_browser <url>: into Orca's per-worktree browser pane via the orca CLI when it is
# there (Orca puts it on the PATH of its terminals); the printed URL is the fallback either way.
open_in_orca_browser() {
  local cli
  cli="$(command -v orca 2>/dev/null || true)"
  [ -n "$cli" ] || [ ! -x "${ORCA_REMOTE_CLI_BIN_DIR:-/nonexistent}/orca" ] || cli="$ORCA_REMOTE_CLI_BIN_DIR/orca"
  [ -n "$cli" ] || { log "orca CLI not on PATH: open the URL above (from an Orca terminal, links open in the worktree browser)"; return 0; }
  if "$cli" tab create --url "$1" --worktree active >/dev/null 2>&1; then
    log "desktop opened in Orca's browser pane for this worktree"
  else
    log "could not open a browser tab through the orca CLI (not inside an Orca worktree terminal?): open the URL above"
  fi
}

# ---------------------------------------------------------------------------
# Mode dispatch
# ---------------------------------------------------------------------------
MODE=run
ENV_CMD=""
FRESH="${ORCA_DOCKER_FRESH:-0}"
BUILD_ARGS=()
GC_ALL=0
RM_TARGET=""
SESSION_TARGET=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --version) echo "orca-docker $VERSION"; exit 0 ;;
    --build) MODE=build; shift ;;
    --no-cache|--pull) BUILD_ARGS+=("$1"); shift ;;
    --gc) MODE=gc; shift ;;
    --all) GC_ALL=1; shift ;;
    --sessions|--ls) MODE=sessions; shift ;;
    --rm-session) MODE="rm"; RM_TARGET="${2:-${ORCA_TAB_ID:-}}"; shift; [ $# -gt 0 ] && shift ;;
    --fresh) FRESH=1; shift ;;
    --shell) MODE=run; set -- bash "${@:2}"; break ;;
    --print-config) MODE=print; shift ;;
    env) MODE="env"; ENV_CMD="${2:-}"; shift; [ $# -gt 0 ] && shift; break ;;
    shell|desktop)  # optional <tab|container>, then (shell) arguments for bash
      MODE="$1"; shift
      case "${1:-}" in ""|-*) ;; *) SESSION_TARGET="$1"; shift ;; esac
      break ;;
    --) shift; break ;;
    -*) die "unknown option: $1 (agent arguments go after the agent name)" ;;
    *) break ;;
  esac
done

command -v docker >/dev/null 2>&1 || die "docker CLI not found in PATH"

case "$MODE" in
  build)
    [ -f "$REPO_IMAGE_DIR/Dockerfile" ] || die "no image/Dockerfile next to this script ($REPO_IMAGE_DIR); use the published image instead"
    log "building $DEFAULT_IMAGE from $REPO_IMAGE_DIR"
    exec docker build "${BUILD_ARGS[@]+"${BUILD_ARGS[@]}"}" -t "$DEFAULT_IMAGE" "$REPO_IMAGE_DIR"
    ;;
  sessions)
    docker ps -a --filter "label=$LABEL" \
      --format 'table {{.Names}}\t{{.Status}}\t{{.Label "orca-docker.kind"}}\t{{.Label "orca-docker.branch"}}\t{{.Label "orca-docker.worktree"}}'
    exit 0
    ;;
  rm)
    [ -n "$RM_TARGET" ] || die "--rm-session needs a tab id or container name (or ORCA_TAB_ID in the environment)"
    for cand in "$RM_TARGET" "$(container_name "$RM_TARGET")"; do
      if docker container inspect "$cand" >/dev/null 2>&1; then
        docker rm -f "$cand" >/dev/null && log "removed session $cand"
        exit 0
      fi
    done
    die "no session container for '$RM_TARGET'"
    ;;
  gc)
    days="${ORCA_DOCKER_GC_DAYS:-14}"
    now="$(date +%s)"
    removed=0
    while IFS=' ' read -r id name finished kind; do
      [ -n "$id" ] || continue
      [ "$kind" != env ] || continue  # workspace environments belong to Orca: `orca-docker env destroy`
      if [ "$GC_ALL" != 1 ]; then
        fin="$(date -d "$finished" +%s 2>/dev/null || echo "$now")"
        [ $(( now - fin )) -ge $(( days * 86400 )) ] || continue
      fi
      docker rm -f "$id" >/dev/null && { log "removed $name"; removed=$((removed + 1)); }
    done < <(docker ps -a --filter "label=$LABEL" --filter status=exited --filter status=created --filter status=dead -q |
             xargs -r docker inspect --format '{{.Id}} {{.Name}} {{.State.FinishedAt}} {{index .Config.Labels "orca-docker.kind"}}')
    [ "$removed" -gt 0 ] || log "nothing to clean (stopped sessions are kept ${days} days; use --gc --all to remove them now)"
    exit 0
    ;;
  shell|desktop)
    session_container "$SESSION_TARGET"
    if [ "$MODE" = desktop ]; then
      port="$(docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$SESSION_CONTAINER" | sed -n 's/^ORCA_DOCKER_NOVNC_PORT=//p')"
      [ -n "$port" ] || die "$SESSION_CONTAINER has no desktop (ORCA_DOCKER_DESKTOP=0)"
      url="http://127.0.0.1:${port}/vnc.html?autoconnect=1&resize=scale"
      echo "$url"
      [ "${SESSION_STARTED_HERE:-0}" = 0 ] || log "started $SESSION_CONTAINER for its desktop; it stays running (orca-docker --sessions)"
      open_in_orca_browser "$url"
      exit 0
    fi
    log "shell in $SESSION_CONTAINER ($(docker container inspect -f '{{index .Config.Labels "orca-docker.worktree"}}' "$SESSION_CONTAINER"))"
    SHELL_CMD=(docker exec -u "$(id -un)" -w "$(docker container inspect -f '{{index .Config.Labels "orca-docker.worktree"}}' "$SESSION_CONTAINER")"
      -e HOME="$HOME" -e USER="$(id -un)" -e LOGNAME="$(id -un)" -e TERM="${TERM:-xterm-256color}")
    if [ -t 0 ] && [ -t 1 ]; then SHELL_CMD+=(-it); else SHELL_CMD+=(-i); fi
    code=0
    "${SHELL_CMD[@]}" "$SESSION_CONTAINER" bash -l "$@" || code=$?
    if [ "${SESSION_STARTED_HERE:-0}" = 1 ] && [ "${ORCA_DOCKER_KEEP_RUNNING:-0}" != 1 ]; then
      docker stop -t 5 "$SESSION_CONTAINER" >/dev/null 2>&1 || true  # we woke it up only for this shell
    fi
    exit "$code"
    ;;
esac

[ "$MODE" = env ] || [ $# -gt 0 ] || { usage; die "missing agent command (e.g. orca-docker claude)"; }

# ---------------------------------------------------------------------------
# Identity: worktree, user, Orca tab
# ---------------------------------------------------------------------------
WORKTREE="$(pwd -P)"
if [ "$MODE" = env ] && [ -n "${ORCA_REPO_PATH:-}" ]; then
  WORKTREE="$(cd "$ORCA_REPO_PATH" 2>/dev/null && pwd -P)" || die "ORCA_REPO_PATH does not exist: $ORCA_REPO_PATH"
fi
[ -d "$WORKTREE" ] || die "cwd does not exist: $WORKTREE"
case "$WORKTREE" in /) die "refusing to use / as the worktree" ;; esac

HOST_UID="$(id -u)"; HOST_GID="$(id -g)"; HOST_USER="$(id -un)"
HOST_HOME="${HOME:?HOME must be set}"
[ "$HOST_UID" != 0 ] || log "warning: running as root; Claude refuses --dangerously-skip-permissions as root"

hash_mod() {  # hash_mod <string> <modulus>
  local h
  h="$(printf '%s' "$1" | cksum | cut -d' ' -f1)"
  echo $(( h % $2 ))
}

TAB_ID="${ORCA_TAB_ID:-}"
if [ "$MODE" = env ]; then
  # One container per Orca workspace: keyed by the recipe instance Orca hands us (stable across
  # create/suspend/resume/destroy), readable thanks to the workspace name.
  ENV_INSTANCE="${ORCA_VM_INSTANCE_ID:-manual-$(date +%s)-$$}"
  ENV_WORKSPACE="${ORCA_WORKSPACE_NAME:-$(basename "$WORKTREE")}"
  SESSION_KEY="env-$(slugify "$ENV_WORKSPACE" | cut -c1-24)-$(printf '%s' "${ENV_INSTANCE#orca-}" | tr -cd 'A-Za-z0-9' | cut -c1-8)"
elif [ -n "$TAB_ID" ]; then
  SESSION_KEY="$TAB_ID"
else
  # Standalone: one session per directory, so `orca-docker claude` in the same repo resumes.
  SESSION_KEY="local-$(basename "$WORKTREE")-$(hash_mod "$WORKTREE" 100000)"
fi
SLUG="$(slugify "$SESSION_KEY")"
CONTAINER="$(container_name "$SESSION_KEY")"
BRANCH="${ORCA_DOCKER_BRANCH:-${ORCA_REPO_BRANCH:-orca/${SLUG}}}"
STATE_DIR="${ORCA_DOCKER_STATE_DIR:-${XDG_STATE_HOME:-$HOST_HOME/.local/state}/orca-docker}"

# ---------------------------------------------------------------------------
# Networking + ports. With --network host every container shares the host's
# TCP ports *and* the X11 abstract socket namespace, so display number, VNC
# and noVNC ports must be unique per tab.
# ---------------------------------------------------------------------------
UNAME="$(uname -s)"
NETWORK="${ORCA_DOCKER_NETWORK:-}"
if [ -z "$NETWORK" ]; then
  # Tabs need host networking so the copied hook script reaches Orca on 127.0.0.1; an environment
  # runs Orca's relay (and hook server) inside, so it can stay on an isolated bridge network.
  if [ "$MODE" = env ]; then NETWORK=bridge; else case "$UNAME" in Linux) NETWORK=host ;; *) NETWORK=bridge ;; esac; fi
fi

port_free() {
  if command -v ss >/dev/null 2>&1; then
    ! ss -Hltn "sport = :$1" 2>/dev/null | grep -q .
  else
    ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
  fi
}

display_free() {  # X11 unix sockets live in a shared abstract namespace under --network host
  [ ! -e "/tmp/.X11-unix/X$1" ] || return 1
  if command -v ss >/dev/null 2>&1; then
    ! ss -Hxl 2>/dev/null | grep -q "@/tmp/.X11-unix/X$1 "
  fi
}

ssh_port_free() {  # a port the user's known_hosts already pins to another key would make Orca refuse the new key
  port_free "$1" || return 1
  [ "$MODE" = env ] || return 0
  ! docker ps -a --filter "label=orca-docker.ssh-port=$1" -q 2>/dev/null | grep -q . || return 1
  if command -v ssh-keygen >/dev/null 2>&1 && [ -f "$HOST_HOME/.ssh/known_hosts" ]; then
    ! ssh-keygen -F "[127.0.0.1]:$1" -f "$HOST_HOME/.ssh/known_hosts" 2>/dev/null | grep -q .
  fi
}

allocate_slots() {
  SLOT="$(hash_mod "$SESSION_KEY" 900)"
  for _ in $(seq 1 60); do
    DISPLAY_NUM=$((100 + SLOT))
    VNC_PORT=$((25000 + SLOT))
    NOVNC_PORT=$((26000 + SLOT))
    SSH_PORT=$((27000 + SLOT))
    if [ "$NETWORK" != host ]; then
      port_free "$NOVNC_PORT" && ssh_port_free "$SSH_PORT" && break
    elif port_free "$VNC_PORT" && port_free "$NOVNC_PORT" && ssh_port_free "$SSH_PORT" && display_free "$DISPLAY_NUM"; then
      break
    fi
    SLOT=$(( (SLOT + 1) % 900 ))
  done
}

# ---------------------------------------------------------------------------
# Image resolution: explicit > per-repo Dockerfile > default
# ---------------------------------------------------------------------------
image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

resolve_image() {
  if [ -n "${ORCA_DOCKER_IMAGE:-}" ]; then
    echo "$ORCA_DOCKER_IMAGE"; return
  fi
  local df="${ORCA_DOCKER_DOCKERFILE:-}"
  if [ -z "$df" ]; then
    for candidate in "$WORKTREE/docker/Dockerfile" "$WORKTREE/.orca-docker/Dockerfile"; do
      [ -f "$candidate" ] && { df="$candidate"; break; }
    done
  fi
  if [ -n "$df" ]; then
    [ -f "$df" ] || die "ORCA_DOCKER_DOCKERFILE not found: $df"
    local ctx hash tag
    ctx="$(cd "$(dirname "$df")" && pwd -P)"
    # Content hash of the build context (files + Dockerfile) keys the cached image.
    hash="$( (cd "$ctx" && find . -type f -not -path './.git/*' -print0 | sort -z | xargs -0 sha256sum; sha256sum "$df") | sha256sum | cut -c1-12)"
    tag="orca-docker-repo:${hash}"
    if ! image_exists "$tag"; then
      log "building per-repo image $tag from $df"
      docker build -f "$df" -t "$tag" --label orca-docker.repo-image=1 "$ctx" >&2 || die "per-repo image build failed"
    fi
    echo "$tag"; return
  fi
  echo "$DEFAULT_IMAGE"
}

ensure_image() {
  IMAGE="$(resolve_image)"
  if ! image_exists "$IMAGE"; then
    if [ "$IMAGE" = "$DEFAULT_IMAGE" ] && ! docker pull "$IMAGE" >&2; then
      if [ -f "$REPO_IMAGE_DIR/Dockerfile" ]; then
        log "pull failed; building $IMAGE locally from $REPO_IMAGE_DIR"
        docker build -t "$IMAGE" "$REPO_IMAGE_DIR" >&2 || die "image build failed"
      else
        die "image $IMAGE is not available"
      fi
    elif [ "$IMAGE" != "$DEFAULT_IMAGE" ]; then
      docker pull "$IMAGE" >&2 || die "image $IMAGE is not available"
    fi
  fi
}

# ---------------------------------------------------------------------------
# Host repository facts (what gets cloned, and what publish is measured against)
# ---------------------------------------------------------------------------
IS_GIT=0 BASE="" BASE_BRANCH="" ORIGIN=""
if command -v git >/dev/null 2>&1 && git -C "$WORKTREE" rev-parse --git-dir >/dev/null 2>&1 \
   && BASE="$(git -C "$WORKTREE" rev-parse --verify -q HEAD)"; then
  IS_GIT=1
  BASE_BRANCH="$(git -C "$WORKTREE" symbolic-ref -q --short HEAD || true)"
  ORIGIN="$(git -C "$WORKTREE" remote get-url origin 2>/dev/null || true)"
fi

SEED_REF=""
if [ "$MODE" = env ] && [ "$IS_GIT" = 1 ]; then
  # Provisioned-root contract: check out exactly the commit Orca pinned (ORCA_REPO_REF_HEAD) on
  # ORCA_REPO_BRANCH; never re-resolve the moving ref. Falls back to the checkout's HEAD when Orca
  # runs the recipe in orca-worktree mode (no pinned source).
  if [ -n "${ORCA_REPO_REF_HEAD:-}" ]; then
    if ! git -C "$WORKTREE" cat-file -e "${ORCA_REPO_REF_HEAD}^{commit}" 2>/dev/null && [ -n "${ORCA_REPO_URL:-}" ]; then
      # ORCA_REPO_URL/ORCA_REPO_REF are the matched pair Orca resolved the pin against (objects only;
      # no host ref is created or moved).
      log "fetching ${ORCA_REPO_REF:-HEAD} from $ORCA_REPO_URL for pinned commit ${ORCA_REPO_REF_HEAD:0:7}"
      GIT_TERMINAL_PROMPT=0 git -C "$WORKTREE" fetch -q "$ORCA_REPO_URL" "${ORCA_REPO_REF:-HEAD}" >&2 || true
    fi
    git -C "$WORKTREE" cat-file -e "${ORCA_REPO_REF_HEAD}^{commit}" 2>/dev/null \
      || die "pinned commit $ORCA_REPO_REF_HEAD is not in $WORKTREE (fetch it first)"
    BASE="$(git -C "$WORKTREE" rev-parse --verify -q "${ORCA_REPO_REF_HEAD}^{commit}")"
  fi
  ref="${ORCA_REPO_REF:-}"
  case "$ref" in
    refs/heads/*) BASE_BRANCH="${ref#refs/heads/}" ;;
    refs/remotes/*) BASE_BRANCH="${ref#refs/remotes/}"; BASE_BRANCH="${BASE_BRANCH#*/}" ;;
    "") ;;
    *)
      if git -C "$WORKTREE" show-ref -q --verify "refs/remotes/$ref"; then BASE_BRANCH="${ref#*/}"   # origin/main
      elif [[ "$ref" =~ ^[0-9a-f]{7,40}$ ]] && ! git -C "$WORKTREE" show-ref -q --verify "refs/heads/$ref"; then BASE_BRANCH=""
      else BASE_BRANCH="$ref"; fi ;;
  esac
  [ "$BASE_BRANCH" != "$BRANCH" ] || BASE_BRANCH=""
  [ -z "${ORCA_REPO_URL:-}" ] || ORIGIN="$ORCA_REPO_URL"
  SEED_REF="orca-docker-seed-${SLUG}"
  if [ "${ORCA_RECIPE_RESULT_SCHEMA_VERSION:-2}" = 1 ] && [ -z "${ORCA_DOCKER_BRANCH:-}" ]; then
    # orca-worktree mode: Orca adds its own linked worktree for ORCA_REPO_BRANCH inside the
    # container, so the primary checkout must sit on the base branch, not on that one.
    BRANCH="${BASE_BRANCH:-orca-docker/primary}"
  fi
fi

PUBLISH="${ORCA_DOCKER_PUBLISH:-}"
if [ -z "$PUBLISH" ]; then
  if [ -n "$ORIGIN" ]; then PUBLISH=push; else PUBLISH=local; fi
fi
case "$PUBLISH" in local|push|pr|off) ;; *) die "ORCA_DOCKER_PUBLISH must be local, push, pr or off" ;; esac

# ---------------------------------------------------------------------------
# docker create assembly (the container's main process is the desktop supervisor)
# ---------------------------------------------------------------------------
build_create_cmd() {
  local hostname_slug
  hostname_slug="$(printf '%s' "$SLUG" | tr -c 'A-Za-z0-9-' '-' | cut -c1-20 | sed 's/-*$//')"
  CREATE=(docker create --name "$CONTAINER" --hostname "orca-${hostname_slug}"
    --label "$LABEL"
    --label "orca-docker.session=${SESSION_KEY}"
    --label "orca-docker.worktree=${WORKTREE}"
    --label "orca-docker.branch=${BRANCH}"
    --label "orca-docker.base=${BASE}"
    --label "orca-docker.agent=$(basename -- "$1")"
    --shm-size=1g
    -e ORCA_DOCKER_UID="$HOST_UID" -e ORCA_DOCKER_GID="$HOST_GID"
    -e ORCA_DOCKER_USER="$HOST_USER" -e ORCA_DOCKER_HOME="$HOST_HOME"
    -e DISPLAY=":${DISPLAY_NUM}"
    -e ORCA_DOCKER_VNC_PORT="$VNC_PORT" -e ORCA_DOCKER_NOVNC_PORT="$NOVNC_PORT"
  )
  [ -n "${ORCA_WORKTREE_ID:-}" ] && CREATE+=(--label "orca-docker.worktree-id=${ORCA_WORKTREE_ID}")
  for name in ORCA_DOCKER_DESKTOP ORCA_DOCKER_DISPLAY_SIZE; do
    [ -n "${!name:-}" ] && CREATE+=(-e "$name")
  done
  if [ "$MODE" = env ]; then
    CREATE+=(--label orca-docker.kind=env
      --label "orca-docker.instance=${ENV_INSTANCE}"
      --label "orca-docker.workspace=${ENV_WORKSPACE}"
      --label "orca-docker.workspace-id=${ORCA_WORKSPACE_ID:-}"
      --label "orca-docker.ssh-port=${SSH_PORT}"
      --label "orca-docker.ssh-key=${ENV_KEY}"
      --label "orca-docker.checkout-mode=${ENV_CHECKOUT_MODE}"
      -e ORCA_DOCKER_SSH_PUBKEY="$(cat "$ENV_KEY.pub")")
  fi
  if [ "$NETWORK" = host ]; then
    CREATE+=(--network host -e ORCA_DOCKER_BIND=127.0.0.1)
    [ "$MODE" != env ] || CREATE+=(-e ORCA_DOCKER_SSH_PORT="$SSH_PORT" -e ORCA_DOCKER_SSH_BIND=127.0.0.1)
  else
    CREATE+=(--network "$NETWORK" -e ORCA_DOCKER_BIND=0.0.0.0
             -p "127.0.0.1:${NOVNC_PORT}:${NOVNC_PORT}"
             --add-host host.docker.internal:host-gateway)
    [ "$MODE" != env ] || CREATE+=(-p "127.0.0.1:${SSH_PORT}:22")
  fi
  if [ -n "${ORCA_DOCKER_ARGS:-}" ]; then
    # shellcheck disable=SC2206
    CREATE+=($ORCA_DOCKER_ARGS)
  fi
  CREATE+=("$IMAGE")
}

# `docker exec` line that runs one agent launch inside the (running) container.
# `-e NAME` copies the value from this process, so no quoting issues.
# ORCA_* carries pane/tab identity + hook coordinates; CLAUDE_*/ANTHROPIC_* carry agent config.
build_exec_cmd() {
  EXEC=(docker exec -u "$HOST_USER" -w "$WORKTREE"
    -e HOME="$HOST_HOME" -e USER="$HOST_USER" -e LOGNAME="$HOST_USER"
    -e ORCA_DOCKER_REPO="$WORKTREE" -e ORCA_DOCKER_PUBLISH="$PUBLISH")
  if [ -t 0 ] && [ -t 1 ]; then EXEC+=(-it); else EXEC+=(-i); fi
  while IFS= read -r name; do
    case "$name" in
      ORCA_DOCKER_UID|ORCA_DOCKER_GID|ORCA_DOCKER_USER|ORCA_DOCKER_HOME|ORCA_DOCKER_VNC_PORT|ORCA_DOCKER_NOVNC_PORT|ORCA_DOCKER_BIND|ORCA_DOCKER_REPO|ORCA_DOCKER_PUBLISH) ;;
      ORCA_DOCKER_IMAGE|ORCA_DOCKER_DOCKERFILE|ORCA_DOCKER_DEFAULT_IMAGE|ORCA_DOCKER_NETWORK|ORCA_DOCKER_ARGS|ORCA_DOCKER_SEED|ORCA_DOCKER_BRANCH|ORCA_DOCKER_FRESH|ORCA_DOCKER_KEEP_RUNNING|ORCA_DOCKER_CARRY_CHANGES|ORCA_DOCKER_GC_DAYS) ;;
      ORCA_POSIX_SHELL_STARTUP_COMMAND|ORCA_ZDOTDIR|ZDOTDIR) ;;
      ORCA_*|CLAUDE_*|ANTHROPIC_*|TERM|COLORTERM|LANG|LC_*|TZ|GIT_AUTHOR_*|GIT_COMMITTER_*) EXEC+=(-e "$name") ;;
    esac
  done < <(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | sort -u)
  EXEC+=("$CONTAINER" /opt/orca-docker/run-agent.sh "$@")
}

# ---------------------------------------------------------------------------
# Seeding: copies (never mounts) of what the session needs from the host
# ---------------------------------------------------------------------------
cexec() { docker exec -u "$HOST_USER" "$CONTAINER" "$@"; }
dcp() { docker cp -aq "$@" 2>/dev/null || docker cp -a "$@"; }  # -a keeps uid/gid (host uid == container uid)

# Directories are streamed through tar with symlinks dereferenced: `docker cp` rejects links
# that point outside the copied tree (e.g. ~/.claude/skills/x -> ../../.agents/skills/x),
# and the link target would not exist in the container anyway. Dangling links are skipped.
copy_in() {  # copy_in <host path> [container path] [excluded top-level entries...]
  local src="$1" dst="${2:-$1}"
  shift; [ $# -eq 0 ] || shift
  [ -e "$src" ] || return 0
  if [ -d "$src" ]; then
    local ex=() e rc=0
    for e in "$@"; do ex+=("--exclude=./$e"); done
    cexec mkdir -p "$dst" 2>/dev/null || docker exec -u 0 "$CONTAINER" mkdir -p "$dst"
    set +o pipefail  # tar exits 1 for skipped dangling links; only the extraction result matters
    tar -C "$src" -ch --warning=no-file-removed "${ex[@]}" -f - . 2>/dev/null |
      docker exec -i -u "$HOST_USER" "$CONTAINER" tar -xf - -C "$dst" 2>/dev/null || rc=$?
    set -o pipefail
    [ "$rc" -eq 0 ] || log "warning: could not copy $src into the session (tar exit $rc)"
  else
    cexec mkdir -p "$(dirname "$dst")" 2>/dev/null || docker exec -u 0 "$CONTAINER" mkdir -p "$(dirname "$dst")"
    dcp -L "$src" "$CONTAINER:$dst"
  fi
}

copy_in_if_newer() {  # only replace the container's copy when the host file changed more recently
  local src="$1" host_m cont_m
  [ -f "$src" ] || return 0
  host_m="$(stat -c %Y "$src" 2>/dev/null || stat -f %m "$src")"
  cont_m="$(cexec stat -c %Y "$src" 2>/dev/null || echo 0)"
  [ "$host_m" -gt "$cont_m" ] && copy_in "$src"
  return 0
}

SEED_TMP=""
trap '[ -z "$SEED_TMP" ] || rm -rf "$SEED_TMP"' EXIT
seed_repo() {
  local tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/orca-docker-seed.XXXXXX")"
  SEED_TMP="$tmp"
  if [ "$IS_GIT" = 1 ]; then
    # Per-session ref name: concurrent tabs of the same worktree bundle at the same time.
    local refs=(HEAD) dirty_ref="refs/heads/orca-docker-seed-dirty-${SLUG}"
    if [ -n "$SEED_REF" ]; then
      # Environment: the pinned commit travels under a throwaway branch (bundles carry refs, not shas).
      git -C "$WORKTREE" update-ref "refs/heads/$SEED_REF" "$BASE"
      refs=("refs/heads/$SEED_REF")
    elif [ -n "$BASE_BRANCH" ]; then
      refs+=("refs/heads/$BASE_BRANCH")
    fi
    if [ "$MODE" != env ] && [ "${ORCA_DOCKER_CARRY_CHANGES:-1}" != 0 ] && [ -n "$(git -C "$WORKTREE" status --porcelain 2>/dev/null)" ]; then
      # Snapshot tracked + untracked (non-ignored) changes as a throwaway commit so the clone
      # starts with the same uncommitted changes; the ref is removed from the host right after.
      local idx tree commit
      idx="$tmp/index"
      GIT_INDEX_FILE="$idx" git -C "$WORKTREE" read-tree HEAD
      GIT_INDEX_FILE="$idx" git -C "$WORKTREE" add -A . >/dev/null 2>&1 || true
      tree="$(GIT_INDEX_FILE="$idx" git -C "$WORKTREE" write-tree)"
      commit="$(GIT_AUTHOR_NAME=orca-docker GIT_AUTHOR_EMAIL=orca-docker@localhost \
                GIT_COMMITTER_NAME=orca-docker GIT_COMMITTER_EMAIL=orca-docker@localhost \
                git -C "$WORKTREE" commit-tree "$tree" -p "$BASE" -m "orca-docker seed: host uncommitted changes")"
      git -C "$WORKTREE" update-ref "$dirty_ref" "$commit"
      refs+=("$dirty_ref")
      log "carrying the host's uncommitted changes into the clone (they stay untouched on the host)"
    fi
    git -C "$WORKTREE" bundle create -q "$tmp/repo.bundle" "${refs[@]}" || die "could not bundle the repository"
    git -C "$WORKTREE" update-ref -d "$dirty_ref" 2>/dev/null || true
    [ -z "$SEED_REF" ] || git -C "$WORKTREE" update-ref -d "refs/heads/$SEED_REF" 2>/dev/null || true
  else
    log "warning: $WORKTREE is not a git repository (or has no commits): copying it as-is; publishing is disabled"
    tar -C "$WORKTREE" --exclude=./node_modules --exclude=./.venv -cf "$tmp/repo.tar" .
  fi
  docker exec -u 0 "$CONTAINER" mkdir -p /run/orca-docker/seed
  dcp "$tmp/." "$CONTAINER:/run/orca-docker/seed"
  docker exec -u 0 \
    -e ORCA_DOCKER_UID="$HOST_UID" -e ORCA_DOCKER_GID="$HOST_GID" -e ORCA_DOCKER_HOME="$HOST_HOME" \
    -e ORCA_DOCKER_REPO="$WORKTREE" -e ORCA_DOCKER_BASE="$BASE" -e ORCA_DOCKER_BASE_BRANCH="$BASE_BRANCH" \
    -e ORCA_DOCKER_BRANCH="$BRANCH" -e ORCA_DOCKER_ORIGIN="$ORIGIN" -e ORCA_DOCKER_DIRTY_REF="orca-docker-seed-dirty-${SLUG}" \
    -e ORCA_DOCKER_SEED_REF="$SEED_REF" \
    "$CONTAINER" /opt/orca-docker/bootstrap-repo.sh || die "repository bootstrap failed"
  rm -rf "$tmp"; SEED_TMP=""
}

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOST_HOME/.claude}"
# Per-session state Claude keeps under its config dir: it belongs to the container, not the
# host, and can be large. Everything else (settings, credentials, hooks, skills, commands,
# agents, plugins, output styles, CLAUDE.md, ...) is copied so settings.json references resolve.
CLAUDE_STATE_DIRS=(projects todos statsig debug cache shell-snapshots file-history downloads telemetry ide session-env backups paste-cache)
seed_agent_state() {  # first launch only
  copy_in "$HOST_HOME/.claude.json"
  copy_in "$CLAUDE_DIR" "$CLAUDE_DIR" "${CLAUDE_STATE_DIRS[@]}"
  copy_in "$HOST_HOME/.gitconfig"
  copy_in "$HOST_HOME/.config/git"
  if [ -n "${ORCA_DOCKER_SEED:-}" ]; then
    for p in $ORCA_DOCKER_SEED; do
      case "$p" in /*) ;; '~'/*) p="$HOST_HOME/${p#'~'/}" ;; *) p="$HOST_HOME/$p" ;; esac
      copy_in "$p"
    done
  fi
}

seed_launch_state() {  # every launch: Orca rotates hook port/token per app run, login tokens refresh
  copy_in "$HOST_HOME/.orca/agent-hooks"
  [ -z "${ORCA_AGENT_HOOK_ENDPOINT:-}" ] || copy_in "$(dirname "$ORCA_AGENT_HOOK_ENDPOINT")"
  copy_in_if_newer "$CLAUDE_DIR/.credentials.json"
  copy_in_if_newer "$CLAUDE_DIR/settings.json"   # Orca (re)installs its status hook here
}

# ---------------------------------------------------------------------------
# Publish: serve `orca-docker publish` requests coming out of the container
# ---------------------------------------------------------------------------
github_web_url() {  # github_web_url <remote url> → https://github.com/owner/repo (empty if not GitHub)
  case "$1" in
    git@github.com:*) printf 'https://github.com/%s' "$(printf '%s' "${1#git@github.com:}" | sed 's/\.git$//')" ;;
    https://github.com/*|http://github.com/*|ssh://git@github.com/*)
      printf 'https://github.com/%s' "$(printf '%s' "$1" | sed -e 's#^[a-z]*://\(git@\)\{0,1\}github.com/##' -e 's/\.git$//')" ;;
  esac
}

handle_publish() {  # handle_publish <seq>
  local seq="$1" tmp meta bundle result branch base_branch subject commits url="" note="" err=""
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/orca-docker-pub.XXXXXX")"
  meta="$tmp/meta"; bundle="$tmp/repo.bundle"; result="$tmp/result"
  dcp "$CONTAINER:/run/orca-docker/outbox/$seq.meta" "$meta"
  dcp "$CONTAINER:/run/orca-docker/outbox/$seq.bundle" "$bundle"
  branch="$(sed -n 's/^branch=//p' "$meta")"; base_branch="$(sed -n 's/^base_branch=//p' "$meta")"
  subject="$(sed -n 's/^subject=//p' "$meta")"; commits="$(sed -n 's/^commits=//p' "$meta")"

  if [ "$IS_GIT" != 1 ]; then
    err="host directory is not a git repository"
  elif ! git -C "$WORKTREE" bundle verify "$bundle" >/dev/null 2>&1; then
    err="bundle does not apply to $WORKTREE (missing base commits?)"
  elif ! git -C "$WORKTREE" fetch -q "$bundle" "+refs/heads/$branch:refs/heads/$branch" 2>"$tmp/fetch.err"; then
    err="could not update local branch $branch: $(tr '\n' ' ' <"$tmp/fetch.err")"
  else
    url="$WORKTREE (branch $branch)"
    if [ "$PUBLISH" = push ] || [ "$PUBLISH" = pr ]; then
      if [ -z "$ORIGIN" ]; then
        note="no origin remote: branch only exists locally"
      elif GIT_TERMINAL_PROMPT=0 git -C "$WORKTREE" push -q -u origin "refs/heads/$branch:refs/heads/$branch" 2>"$tmp/push.err"; then
        url="$ORIGIN $branch"
        local web; web="$(github_web_url "$ORIGIN")"
        if [ -n "$web" ]; then
          url="$web/tree/$branch"
          if [ "$PUBLISH" = pr ] && command -v gh >/dev/null 2>&1; then
            local pr_url
            if pr_url="$(gh pr view "$branch" --repo "${web#https://github.com/}" --json url -q .url 2>/dev/null)"; then
              url="$pr_url"; note="pull request updated"
            elif pr_url="$(cd "$WORKTREE" && gh pr create --head "$branch" ${base_branch:+--base "$base_branch"} \
                             --title "$subject" --body "Published by orca-docker from an isolated session ($commits commit(s))." 2>"$tmp/gh.err")"; then
              url="$pr_url"; note="pull request created"
            else
              note="pushed, but gh pr create failed: $(tail -1 "$tmp/gh.err")"
              url="$web/compare/${base_branch:+$base_branch...}$branch?expand=1"
            fi
          else
            note="open a pull request: $web/compare/${base_branch:+$base_branch...}$branch?expand=1"
          fi
        fi
      else
        note="pushed to local repo only; push to origin failed: $(tail -1 "$tmp/push.err")"
      fi
    fi
  fi

  if [ -n "$err" ]; then
    printf 'status=error\nerror=%s\n' "$err" > "$result"
    log "publish failed: $err"
  else
    printf 'status=ok\nurl=%s\n' "$url" > "$result"
    [ -n "$note" ] && printf 'note=%s\n' "$note" >> "$result"
    log "published $branch ($commits commit(s)) → $url${note:+  [$note]}"
    # Recorded on the container so `--sessions` and the next launch can show it.
    docker exec -u 0 "$CONTAINER" sh -c 'printf "%s\n" "$1" > /run/orca-docker/last-publish' _ "$url" 2>/dev/null || true
  fi
  dcp "$result" "$CONTAINER:/run/orca-docker/outbox/$seq.result"
  rm -rf "$tmp"
}

publish_watcher() {
  docker exec "$CONTAINER" /opt/orca-docker/outbox-wait.sh 2>/dev/null | while IFS= read -r meta; do
    handle_publish "${meta%.meta}"
  done
}

# ---------------------------------------------------------------------------
# Session lifecycle
# ---------------------------------------------------------------------------
container_state() {
  local s
  s="$(docker container inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null)" || s=""
  echo "${s:-absent}"
}

wait_ready() {
  for _ in $(seq 1 300); do
    if docker exec "$CONTAINER" sh -c '[ -f /run/orca-docker/ready ] && [ /run/orca-docker/ready -nt /proc/1 ]' 2>/dev/null; then
      return 0
    fi
    [ "$(container_state)" = running ] || die "container $CONTAINER stopped during startup: $(docker logs --tail 20 "$CONTAINER" 2>&1 | tail -5)"
    sleep 0.1
  done
  log "warning: container did not report ready in 30s; continuing"
}

# ---------------------------------------------------------------------------
# Environment mode: Orca's per-workspace recipe protocol (examples/orca.yaml)
#   create           -> container + clone, then the SSH connection result as JSON on stdout
#   suspend/resume   -> docker stop / start (resume re-emits the result)
#   destroy          -> docker rm (the only time an environment container is removed)
# Everything else the container prints goes to stderr; stdout is the protocol.
# ---------------------------------------------------------------------------
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }
env_label() { docker container inspect -f "{{index .Config.Labels \"orca-docker.$2\"}}" "$1" 2>/dev/null || true; }

env_payload_field() {  # env_payload_field <payload> <field>  (only our own userData is ever parsed)
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$1" | jq -r ".recipeResult.userData.$2 // empty" 2>/dev/null
  else
    printf '%s' "$1" | sed -n "s/.*\"$2\":\"\\([^\"]*\\)\".*/\\1/p"
  fi
}

env_find_container() {  # explicit name/instance argument > ORCA_VM_INSTANCE_ID > lifecycle payload on stdin
  local cand payload=""
  for cand in "${1:-}" "${ORCA_VM_INSTANCE_ID:-}"; do
    [ -n "$cand" ] || continue
    if docker container inspect "$cand" >/dev/null 2>&1; then echo "$cand"; return 0; fi
    cand="$(docker ps -a --filter "label=orca-docker.instance=$cand" --format '{{.Names}}' | head -1)"
    [ -z "$cand" ] || { echo "$cand"; return 0; }
  done
  [ -t 0 ] || payload="$(cat)"
  for cand in "$(env_payload_field "$payload" container)" "$(env_payload_field "$payload" instance)"; do
    [ -n "$cand" ] || continue
    if docker container inspect "$cand" >/dev/null 2>&1; then echo "$cand"; return 0; fi
    cand="$(docker ps -a --filter "label=orca-docker.instance=$cand" --format '{{.Names}}' | head -1)"
    [ -z "$cand" ] || { echo "$cand"; return 0; }
  done
  return 1
}

USER_KNOWN_HOSTS="$HOST_HOME/.ssh/known_hosts"
# The container's host key is read over `docker exec` (a trusted channel) and recorded for its
# endpoint in the user's known_hosts, as Orca's local-Docker guidance asks, so Orca verifies the
# key instead of trusting first contact. Ports are only ever reused by our own containers (see
# ssh_port_free), so the previous entry for the endpoint is one we wrote for a destroyed container.
env_record_host_key() {  # env_record_host_key <container> <port>
  local c="$1" port="$2" pub line hk="$STATE_DIR/$1.hostkey"
  pub="$(docker exec "$c" cat /etc/ssh/ssh_host_ed25519_key.pub 2>/dev/null | awk '{print $1" "$2}')"
  [ -n "$pub" ] || { log "warning: could not read the container's ssh host key"; return 0; }
  line="[127.0.0.1]:$port $pub"
  printf '%s\n' "$line" > "$hk"
  printf '%s\n' "$line" > "$STATE_DIR/$c.known_hosts"
  install -d -m 700 "$(dirname "$USER_KNOWN_HOSTS")"
  [ -f "$USER_KNOWN_HOSTS" ] || { : > "$USER_KNOWN_HOSTS"; chmod 600 "$USER_KNOWN_HOSTS"; }
  if ssh-keygen -F "[127.0.0.1]:$port" -f "$USER_KNOWN_HOSTS" 2>/dev/null | grep -qF "$pub"; then return 0; fi
  ssh-keygen -q -R "[127.0.0.1]:$port" -f "$USER_KNOWN_HOSTS" >/dev/null 2>&1 || true
  rm -f "$USER_KNOWN_HOSTS.old"
  printf '%s\n' "$line" >> "$USER_KNOWN_HOSTS"
}

env_forget_host_key() {  # env_forget_host_key <container>: drop our known_hosts line only if it is still ours
  local hk="$STATE_DIR/$1.hostkey" line
  [ -f "$hk" ] || return 0
  line="$(cat "$hk")"
  if [ -f "$USER_KNOWN_HOSTS" ] && grep -qxF "$line" "$USER_KNOWN_HOSTS"; then
    grep -vxF "$line" "$USER_KNOWN_HOSTS" > "$USER_KNOWN_HOSTS.orca-docker.tmp" || true
    cat "$USER_KNOWN_HOSTS.orca-docker.tmp" > "$USER_KNOWN_HOSTS"; rm -f "$USER_KNOWN_HOSTS.orca-docker.tmp"
  fi
  rm -f "$hk" "$STATE_DIR/$1.known_hosts"
}

env_result_json() {  # env_result_json <container>
  local c="$1" port key root mode ws inst novnc fp="" user
  port="$(env_label "$c" ssh-port)"; key="$(env_label "$c" ssh-key)"; root="$(env_label "$c" worktree)"
  mode="$(env_label "$c" checkout-mode)"; ws="$(env_label "$c" workspace)"; inst="$(env_label "$c" instance)"
  user="$(docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$c" | sed -n 's/^ORCA_DOCKER_USER=//p')"
  novnc="$(docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$c" | sed -n 's/^ORCA_DOCKER_NOVNC_PORT=//p')"
  [ ! -f "$STATE_DIR/$c.hostkey" ] || fp="$(ssh-keygen -lf "$STATE_DIR/$c.hostkey" 2>/dev/null | awk '{print $2}')"
  local head='"schemaVersion":1,'
  [ "$mode" != provisioned-root ] || head='"schemaVersion":2,"checkoutMode":"provisioned-root",'
  printf '{%s"connection":{"type":"ssh","projectRoot":%s,"target":{"label":%s,"host":"127.0.0.1","port":%s,"username":%s,"identityFile":%s,"identitiesOnly":true}},"userData":{"container":%s,"instance":%s,"novncUrl":%s,"hostKeyFingerprint":%s}}\n' \
    "$head" "$(json_str "$root")" "$(json_str "orca-docker ${ws:-$c}")" "$port" "$(json_str "${user:-$HOST_USER}")" "$(json_str "$key")" \
    "$(json_str "$c")" "$(json_str "$inst")" "$(json_str "http://127.0.0.1:${novnc}/vnc.html?autoconnect=1&resize=scale")" "$(json_str "$fp")"
}

env_wait_ssh() {  # env_wait_ssh <container> <port> <key> <user>
  local c="$1" port="$2" key="$3" user="$4" kh="$STATE_DIR/$1.known_hosts" i
  for i in $(seq 1 120); do
    if command -v ssh >/dev/null 2>&1 && [ -s "$kh" ]; then
      if ssh -q -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$kh" \
             -o ConnectTimeout=3 -o IdentitiesOnly=yes -i "$key" -p "$port" "$user@127.0.0.1" true 2>/dev/null; then
        return 0
      fi
    elif (exec 3<>"/dev/tcp/127.0.0.1/$port" && head -c 4 <&3 | grep -q SSH) 2>/dev/null; then
      return 0
    fi
    [ "$(container_state)" = running ] || die "container $c stopped: $(docker logs --tail 20 "$c" 2>&1 | tail -5)"
    [ "$i" -lt 120 ] || { log "warning: sshd on 127.0.0.1:$port did not answer in 60s ($(docker exec "$c" tail -3 /run/orca-docker/sshd.log 2>/dev/null | tr '\n' ' '))"; return 1; }
    sleep 0.5
  done
}

env_create() {
  local state
  command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen (openssh client) is required on the host for environment mode"
  ENV_CHECKOUT_MODE=orca-worktree
  [ "${ORCA_RECIPE_RESULT_SCHEMA_VERSION:-2}" = 1 ] || ENV_CHECKOUT_MODE=provisioned-root
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
  ENV_KEY="$STATE_DIR/$CONTAINER.ed25519"
  state="$(container_state)"
  if [ "$state" != absent ] && [ "$FRESH" = 1 ]; then
    log "discarding $CONTAINER (--fresh)"; docker rm -f "$CONTAINER" >/dev/null; state=absent
  fi
  if [ "$state" = absent ]; then
    rm -f "$ENV_KEY" "$ENV_KEY.pub" "$STATE_DIR/$CONTAINER.known_hosts" "$STATE_DIR/$CONTAINER.hostkey"
    ssh-keygen -q -t ed25519 -N '' -C "orca-docker $CONTAINER" -f "$ENV_KEY"
    ensure_image
    allocate_slots
    build_create_cmd env
    log "new environment $CONTAINER  workspace ${ENV_WORKSPACE}  image $IMAGE  branch $BRANCH  base ${BASE:-none}  ssh 127.0.0.1:$SSH_PORT"
    "${CREATE[@]}" >/dev/null
    docker start "$CONTAINER" >/dev/null
    wait_ready
    seed_agent_state
    seed_repo
  else
    # Orca retried create for an instance we already have: idempotent.
    [ -f "$ENV_KEY" ] || die "environment $CONTAINER exists but its SSH key $ENV_KEY is gone; run: orca-docker env destroy $CONTAINER"
    [ "$state" = running ] || docker start "$CONTAINER" >/dev/null
    wait_ready
  fi
  SSH_PORT="$(env_label "$CONTAINER" ssh-port)"
  env_record_host_key "$CONTAINER" "$SSH_PORT"
  env_wait_ssh "$CONTAINER" "$SSH_PORT" "$(env_label "$CONTAINER" ssh-key)" "$HOST_USER" ||
    die "sshd in $CONTAINER is not reachable on 127.0.0.1:$SSH_PORT (container kept; docker logs $CONTAINER)"
  env_result_json "$CONTAINER" >&3
}

if [ "$MODE" = env ]; then
  exec 3>&1 1>&2   # stdout is the recipe protocol; everything else (docker cp chatter, logs) goes to stderr
  case "$ENV_CMD" in
    create) env_create ;;
    resume)
      c="$(env_find_container "${1:-}")" || die "no environment container for this instance (destroyed? see: orca-docker env ls)"
      [ "$(docker container inspect -f '{{.State.Status}}' "$c")" = running ] || docker start "$c" >/dev/null
      CONTAINER="$c"; wait_ready
      env_record_host_key "$c" "$(env_label "$c" ssh-port)"
      env_wait_ssh "$c" "$(env_label "$c" ssh-port)" "$(env_label "$c" ssh-key)" "$HOST_USER" ||
        die "sshd in $c is not reachable on 127.0.0.1:$(env_label "$c" ssh-port) (container kept; docker logs $c)"
      env_result_json "$c" >&3
      ;;
    suspend)
      c="$(env_find_container "${1:-}")" || die "no environment container for this instance"
      docker stop -t 10 "$c" >/dev/null; log "suspended $c (container kept)"
      ;;
    destroy|rm)
      c="$(env_find_container "${1:-}")" || { log "nothing to destroy for this instance"; exit 0; }
      key="$(env_label "$c" ssh-key)"
      docker rm -f "$c" >/dev/null
      env_forget_host_key "$c"
      [ -z "$key" ] || rm -f "$key" "$key.pub"
      log "destroyed environment $c"
      ;;
    status|show)
      c="$(env_find_container "${1:-}")" || die "no environment container for this instance"
      docker container inspect -f '{{.Name}}  {{.State.Status}}  workspace={{index .Config.Labels "orca-docker.workspace"}}  ssh=127.0.0.1:{{index .Config.Labels "orca-docker.ssh-port"}}  branch={{index .Config.Labels "orca-docker.branch"}}  repo={{index .Config.Labels "orca-docker.worktree"}}' "$c" >&3
      env_result_json "$c" >&3
      ;;
    ls|list|"")
      docker ps -a --filter "label=orca-docker.kind=env" \
        --format 'table {{.Names}}\t{{.Status}}\t{{.Label "orca-docker.workspace"}}\t127.0.0.1:{{.Label "orca-docker.ssh-port"}}\t{{.Label "orca-docker.branch"}}\t{{.Label "orca-docker.worktree"}}' >&3
      ;;
    *) die "unknown env command: $ENV_CMD (create|suspend|resume|destroy|status|ls)" ;;
  esac
  exit 0
fi

STATE="$(container_state)"
if [ "$FRESH" = 1 ] && [ "$STATE" != absent ]; then
  log "--fresh: removing existing session container $CONTAINER"
  docker rm -f "$CONTAINER" >/dev/null
  STATE=absent
fi

if [ "$STATE" = absent ]; then
  ensure_image
  allocate_slots
  build_create_cmd "$@"
else
  IMAGE="$(docker container inspect -f '{{.Config.Image}}' "$CONTAINER")"
  DISPLAY_NUM="$(docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$CONTAINER" | sed -n 's/^DISPLAY=://p')"
  NOVNC_PORT="$(docker container inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$CONTAINER" | sed -n 's/^ORCA_DOCKER_NOVNC_PORT=//p')"
  BRANCH="$(docker container inspect -f '{{index .Config.Labels "orca-docker.branch"}}' "$CONTAINER")"
  CREATE=()
fi
build_exec_cmd "$@"

if [ "$MODE" = print ]; then
  if [ "${#CREATE[@]}" -gt 0 ]; then printf '%q ' "${CREATE[@]}"; echo; fi
  printf '%q ' "${EXEC[@]}"; echo
  exit 0
fi

if [ "$STATE" = absent ]; then
  log "new session $CONTAINER  image $IMAGE  network $NETWORK  branch $BRANCH"
  "${CREATE[@]}" >/dev/null
  docker start "$CONTAINER" >/dev/null
  wait_ready
  seed_agent_state
  seed_repo
else
  if [ "$STATE" != running ]; then
    log "resuming session $CONTAINER (branch $BRANCH)"
    docker start "$CONTAINER" >/dev/null
  else
    log "attaching to running session $CONTAINER (branch $BRANCH)"
  fi
  wait_ready
fi
seed_launch_state

if [ "${ORCA_DOCKER_DESKTOP:-1}" != 0 ]; then
  log "desktop: http://127.0.0.1:${NOVNC_PORT}/vnc.html?autoconnect=1&resize=scale"
fi

WATCHER_PID=""
if [ "$PUBLISH" != off ]; then
  publish_watcher &
  WATCHER_PID=$!
fi

finish() {
  if [ -n "$WATCHER_PID" ]; then
    kill "$WATCHER_PID" 2>/dev/null || true
    wait "$WATCHER_PID" 2>/dev/null || true
    WATCHER_PID=""
  fi
  if [ "${ORCA_DOCKER_KEEP_RUNNING:-0}" != 1 ]; then
    [ "$(container_state)" != running ] || docker stop -t 5 "$CONTAINER" >/dev/null 2>&1 || true
  else
    docker exec "$CONTAINER" pkill -f outbox-wait.sh >/dev/null 2>&1 || true
  fi
}
on_signal() {
  # The pane is going away (tab closed / Orca quitting): stop the whole session container;
  # it stays on disk and the next launch of this tab resumes it.
  trap - INT TERM HUP
  finish
  exit 130
}
trap on_signal INT TERM HUP

# Run the agent as a background job and wait for it, so signals reach the trap immediately
# instead of after the agent exits; stdin is passed through explicitly (bash would otherwise
# give a background command /dev/null).
exec 3<&0
"${EXEC[@]}" <&3 &
AGENT_PID=$!
code=0
wait "$AGENT_PID" || code=$?
finish
log "session $CONTAINER kept (stopped). Relaunch this tab to resume, or: orca-docker --rm-session ${SESSION_KEY}"
exit "$code"
